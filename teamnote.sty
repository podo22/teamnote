\ProvidesPackage{teamnote}

\usepackage[left=0.5cm, right=0.5cm, top=1.2cm, bottom=0.5cm, headsep=0.3cm, a4paper]{geometry}
\usepackage{fancyhdr}
\usepackage{lastpage}
\usepackage{minted}
\usepackage{color}
\usepackage{indentfirst}
\usepackage{enumitem}
\setlist[itemize]{itemsep=3pt, topsep=1pt, parsep=1pt, partopsep=0pt, leftmargin=1.2em, labelsep=0.3em}
\usepackage[bottomtitles]{titlesec}
\renewcommand{\bottomtitlespace}{0pt}
\titlespacing*{\section}{0pt}{1.0ex plus .2ex}{0.5ex plus .1ex}
\titlespacing*{\subsection}{0pt}{0.8ex plus .2ex}{0.3ex plus .1ex}
\usepackage{multicol}
\raggedcolumns
\setlength{\columnsep}{15pt}
\setlength{\columnseprule}{0.1pt}
\pagenumbering{arabic}
\setminted{breaklines=true, breakanywhere=true, fontfamily=tt, tabsize=2, breaksymbolleft={}, breaksymbolright={}}
\usemintedstyle{perldoc}
\usepackage{xstring}

\AtBeginDocument{
    \makeatletter
    \renewcommand{\fcolorbox}[4][]{#4}
    \let\underline\relax
    \@ifundefined{PYGperldoc@tok@err}{}{
        \expandafter\def\csname PYGperldoc@tok@err\endcsname#1{#1}
    }
    \makeatother
}

\newcommand{\revised}{Should be \textcolor{red}{\textbf{revised}}.}
\newcommand{\tested}{Should be \textcolor{red}{\textbf{tested}}.}
\newcommand{\added}{Should be \textcolor{red}{\textbf{added}}.}
\newcommand{\WIP}{\textcolor{red}{\textbf{WIP}}}

\newcommand{\schoolname}{Some University}
\newcommand{\teamname}{Some Teamname}
\newcommand{\authorname}{Some Members}

\newcommand{\maketitlepage}{
    \maketitle
    \tableofcontents
    %\newpage
    \thispagestyle{fancy}
}
\DeclareRobustCommand{\teamnote}[3]{
    \renewcommand{\schoolname}{#1}
    \renewcommand{\teamname}{#2}
    \renewcommand{\authorname}{#3}
}
\pagestyle{fancy}
\lhead{\schoolname{} -- \teamname}
\rhead{Page \thepage{} of
    \ifthenelse{\pageref{LastPage} < 26}{\pageref{LastPage}}{\textcolor{red}{\textbf{\pageref{LastPage}}}}}
\fancyfoot{}

\title{Team Note of \teamname}
\author{\authorname}
\date{Compiled on \today}

\newboolean{BangShowUsage}
\setboolean{BangShowUsage}{false}
\newcommand{\ShowUsage}{\setboolean{BangShowUsage}{false}}
\newcommand{\HideUsage}{\setboolean{BangShowUsage}{true}}

\newboolean{BangShowComplexity}
\setboolean{BangShowComplexity}{false}
\newcommand{\ShowComplexity}{\setboolean{BangShowComplexity}{false}}
\newcommand{\HideComplexity}{\setboolean{BangShowComplexity}{true}}

\newboolean{BangShowAuthor}
\setboolean{BangShowAuthor}{false}
\newcommand{\ShowAuthor}{\setboolean{BangShowAuthor}{false}}
\newcommand{\HideAuthor}{\setboolean{BangShowAuthor}{true}}

\immediate\write18{python preprocessor.py "\jobname.tex"}

\newcommand{\Algorithm}[6]{
    \ifthenelse{\equal{#1}{}}{}{\subsection{#1}}
    \gdef\hasmeta{0}

    \begingroup
    \setlength{\parskip}{0pt}
    \setlength{\parindent}{0pt}

    \ifthenelse{\equal{#2}{} \OR \boolean{BangShowUsage}}{}{{\raggedright \textbf{Usage:} #2\par}\gdef\hasmeta{1}}

    \ifthenelse{\equal{#3}{} \OR \boolean{BangShowComplexity}}{}{{\raggedright\textbf{Time Complexity:} #3\par}\gdef\hasmeta{1}}

    \ifthenelse{\equal{#6}{} \OR \boolean{BangShowAuthor}}{}{{\textbf{Author:} #6}\gdef\hasmeta{1}}

    \endgroup

    \ifthenelse{\equal{\hasmeta}{1}}{\vspace{-0.5em}}{}
    \ifthenelse{\equal{#5}{}}{}{
        \ifthenelse{\equal{#4}{cpp}}{
            \inputminted[]{cpp}{build/stripped/#5}
        }{
            \ifthenelse{\equal{#4}{}}{
                \inputminted[]{cpp}{#5}
            }{
                \inputminted[]{#4}{#5}
            }
        }
    }
}